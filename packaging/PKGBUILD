# Maintainer: Andre Bruno
pkgname=omarchy-key-remap
pkgver=0.1.0
pkgrel=1
pkgdesc="Key Remap for Omarchy — remap keys and shortcuts system-wide or inside one app (PowerToys Keyboard Manager, ported)"
arch=('any')
url="https://github.com/andrebbruno/omarchy-key-remap"
license=('MIT')
depends=('python' 'keyd')
optdepends=('gum: menu fallback outside Omarchy'
            'polkit: password dialog when applying from the menu')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
checkdepends=('python-pytest')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('55f9c6ca3016845f5e613c91bab79916df7f1c5457444583b9f70b6e1d65fbe2')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  PYTHONPATH="$PWD" python -m pytest tests -q
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 systemd/omarchy-key-remap-apps.service \
    "$pkgdir/usr/lib/systemd/user/omarchy-key-remap-apps.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
